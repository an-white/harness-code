# OmniRoute (OpenAI-compatible endpoint)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-...

# Default model ("auto" or a concrete model name)
OMNIROUTE_MODEL=auto

# Sampling temperature (0.0-2.0)
TEMPERATURE=0.3

# Workspace/runtime (optional)
WORKSPACE_ROOT=                 # Default: current working directory
MAX_FIX_CYCLES=3                # Max review/fix cycles per task
MAX_AGENT_STEPS=25              # Max steps per agent turn
SHELL_TIMEOUT=120               # Shell command timeout (seconds)
SKILLS_AUTO_INSTALL=true        # Flag for skill auto-install (install still requires human approval; T5 pending)

# Interaction language (optional). Precedence: --language > INTERACTION_LANGUAGE > saved preference
INTERACTION_LANGUAGE=           # e.g. en, es, fr

# Per-role models (optional; empty = OMNIROUTE_MODEL)
PM_MODEL=
BUILDER_MODEL=
REVIEWER_MODEL=
QA_MODEL=
SECURITY_MODEL=
TRANSLATOR_MODEL=
RESEARCH_MODEL=

# Research/onboarding limits
RESEARCH_ONBOARDING=auto        # auto|always|never
RESEARCH_MAX_FILES=40
RESEARCH_MAX_BYTES=200000
RESEARCH_CONTEXT_CHARS=8000
RESEARCH_MAX_CYCLES=2

# Web access for research (explicit consent per run; state-only, not persisted)
WEB_ACCESS=ask                  # ask|allow|deny (CLI: --allow-web/--no-web)
WEBFETCH_TIMEOUT=20
WEBFETCH_MAX_BYTES=512000
WEBFETCH_ALLOWED_DOMAINS=       # CSV domains; empty = public domains allowed (private/reserved IPs always blocked)
WEBSEARCH_PROVIDER=none         # none|searxng|tavily|brave
WEBSEARCH_ENDPOINT=
WEBSEARCH_API_KEY=              # Never logged; leave empty if not required

# Deep analysis workflow limits (independent of LangGraph; uses the research
# runtime/role to read/analyze the repo and generate docs/app_flow.md and
# granular docs/deep_analysis/* artifacts). All unlimited/no-limit by default.
# Numeric settings: 0, empty/unset, or "unlimited"/"none" means no effective
# limit; positive integers set an explicit limit.
DEEP_ANALYSIS_UNLIMITED=true    # Global unlimited/no-limit switch (default: true)
DEEP_ANALYSIS_MAX_FILES=0       # 0 = unlimited files/read operations
DEEP_ANALYSIS_MAX_PASSES=0      # 0 = unlimited analysis passes/cycles
DEEP_ANALYSIS_MAX_CHARS=0       # 0 = unlimited characters/tokens budget (as applicable)
DEEP_ANALYSIS_TIMEOUT_SECONDS=0 # 0 = unlimited/no timeout enforced by deep analysis

# CLI/UI input UX (ANSI-capable TTY only; safely ignored/degraded otherwise)
UI_COLORS=true                  # Agent badge and soft input highlight when supported
UI_MOUSE=true                   # Best-effort mouse click cursor positioning in input (SGR)

